# Rust build output
/target/

# Generated by tauri-build on every build.
/gen/schemas/

# NOTE: prompt.txt is intentionally NOT ignored. It is generated by
# `npm run generate:prompt` (scripts/generate-prompt.mjs) and embedded into the
# binary with `include_str!`, so a fresh checkout must run that script before
# `cargo build`. It stays version-controllable for that reason.
