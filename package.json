{
  "name": "helios-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Helios AI — native Windows desktop generative UI chat, built with Tauri v2 and OpenUI.",
  "scripts": {
    "generate:prompt": "node scripts/generate-prompt.mjs",
    "predev": "npm run generate:prompt",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run generate:prompt",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@openuidev/react-headless": "^0.18.9",
    "@openuidev/react-lang": "^1.1.1",
    "@openuidev/react-ui": "^0.18.9",
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@openuidev/lang-core": "1.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@openuidev/lang-core",
      "esbuild"
    ]
  }
}
